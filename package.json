{
  "name": "front-proxy",
  "version": "0.7.1",
  "mcpName": "io.github.gutomezencio/front-proxy",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Guto Mezêncio",
    "email": "gutomezencio@gmail.com"
  },
  "description": "Map/link custom local domains to apps running on local ports, at the OS level. Includes an MCP server so code assistants can manage the domains.",
  "keywords": [
    "local-domain",
    "hosts",
    "etc-hosts",
    "proxy",
    "reverse-proxy",
    "https",
    "mkcert",
    "localhost",
    "cli",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "ai-agents"
  ],
  "homepage": "https://github.com/gutomezencio/front-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gutomezencio/front-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/gutomezencio/front-proxy/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-admin-assets.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "prepack": "npm run build",
    "dev": "npm run build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist dist/proxy-server.js)",
    "start": "npm run build && node dist/proxy-server.js",
    "start:root": "npm run build && node dist/start.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage",
    "build:mcpb": "npm run build && node scripts/build-mcpb.js",
    "sync-version": "node scripts/sync-version.js"
  },
  "bin": {
    "front-proxy": "dist/bin-running.js"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "test/tsconfig.json"
        }
      ]
    },
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 99.9,
        "branches": 96.7,
        "functions": 100,
        "lines": 99.9
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/mcpb/"
    ]
  },
  "dependencies": {
    "@hapi/h2o2": "^10.0.4",
    "@hapi/hapi": "^21.4.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  }
}
